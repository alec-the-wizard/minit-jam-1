-- Memory: find pairs on a table of sliding cards before the clock runs out.
--
-- The rules live here, the table geometry in main/field.lua, the card
-- simulation in main/cards.lua and the face pool in main/deck.lua.
local minit  = require("minit.minit")
local layout = require("minit_platform.layout")
local audio  = require("minit_platform.audio")

local field = require("main.field")
local deck  = require("main.deck")
local cards = require("main.cards")

local FONT_SIZE = 48
local HUD_FONT_UNITS = 0.72       -- label size in layout units
local HUD_TOP_UNITS = 1.0         -- label centre, measured from the top edge
local HUD_SIDE_UNITS = 0.35
local HUD_Z = 0.5
local HUD_LOW_SECONDS = 10
local TABLE_PAUSE = 0.55          -- beat between a cleared table and the next
local BOUNCE_SOUND_GAP = 0.08
local POP_UNITS = 2.2             -- size of the match flash
local REPORT_DELAY_MS = 1000      -- let the last table show before the result
local MUSIC_FADE = 0.8            -- seconds to fade the loop out at the end
local HINT_MAX_UNITS = 8.4        -- longest hint, as a share of the screen width
local HINT_CHAR_EM = 0.61         -- Vera Mono Bold advance per character
local RING_Z = -0.2               -- halo sits behind the cards
local RING_W_SCALE = 2.2          -- halo width, as a share of the card width
local RING_H_SCALE = 1.9          -- halo height, as a share of the card height
local HUD_TIME_COLOR = vmath.vector4(1.0, 0.97, 0.85, 1.0)
local HUD_LOW_COLOR = vmath.vector4(1.0, 0.42, 0.36, 1.0)
local HUD_BEST_UNITS = 0.44        -- best line, a step smaller than the score
local HUD_BEST_TOP_UNITS = 0.64    -- how far under the score line it sits
local BEST_PREFIX = "v1:"          -- user data format, e.g. "v1:563"
local BEST_FLASH = "NEW BEST!"
local MEMORIZE_BONUS_TUTORIAL = 2.0  -- reveal multiplier while "Memorize!" is up
local MEMORIZE_BONUS = 1.25          -- reveal multiplier on every other table

local function number_config(key, fallback, low, high)
    local value = tonumber(minit.get_config_value(key, ""))
    if not value then
        return fallback
    end
    return math.max(low, math.min(high, value))
end

local function read_config()
    local config = {
        round_seconds = number_config(minit.get_config_value("round_seconds", ""), 60, 15, 180),
        start_pairs = math.floor(number_config(minit.get_config_value("start_pairs", ""), 3, 2, 12)),
        max_pairs = math.floor(number_config(minit.get_config_value("max_pairs", ""), 8, 3, 12)),
        card_speed = number_config(minit.get_config_value("card_speed", ""), 2.0, 0.0, 5.0),
        reveal_seconds = number_config(minit.get_config_value("reveal_seconds", ""), 1.5, 0.4, 5.0),
        score_per_pair = math.floor(number_config(minit.get_config_value("score_per_pair", ""), 10, 1, 100)),
    }
    if config.max_pairs < config.start_pairs then
        config.max_pairs = config.start_pairs
    end
    return config
end

-- The player's best run, stored as "v1:<score>" in their single user data slot.
-- A missing slot, an older format or a broken value simply means "no best yet".
local function read_best()
    local raw = minit.get_user_data()
    if not raw then
        return nil
    end
    local score = raw:match("^" .. BEST_PREFIX .. "(%d+)$")
    if not score then
        return nil
    end
    return tonumber(score)
end

local function spawn_pop(x, y, size)
    factory.create(msg.url("#pop_factory"), vmath.vector3(x, y, 0.5), nil, { radius = size })
end

local function label_url(id)
    return msg.url(nil, id, "label")
end

local function set_label_text(id, text)
    go.set(label_url(id), "text", text)
end

-- The hint is a single line (the label does not line-break), so a long hint
-- like the tutorial's shrinks just enough to stay inside a narrow screen.
local function hint_scale(text)
    local scale = HUD_FONT_UNITS * layout.unit / FONT_SIZE
    local width = #text * HINT_CHAR_EM * HUD_FONT_UNITS * layout.unit
    local room = HINT_MAX_UNITS * layout.unit
    if width > room then
        return scale * room / width
    end
    return scale
end

local function set_hint(self, text)
    self.hint = text
    set_label_text(self.hint_id, text)
    go.set_scale(hint_scale(text), self.hint_id)
end

-- While the tutorial talks, the score, the clock and the best line have nothing
-- to say yet, so their label components stay disabled until the player flips a
-- card.
local function set_hud_visible(self, visible)
    local message = visible and "enable" or "disable"
    msg.post(label_url(self.score_id), message)
    msg.post(label_url(self.time_id), message)
    msg.post(label_url(self.best_id), message)
end

-- The hint label names the difficulty of the current table instead of the
-- pair count. Anything past four pairs is already "Impossible!".
local function difficulty_name(pairs)
    if pairs <= 2 then
        return "Easy"
    end
    if pairs == 3 then
        return "Medium"
    end
    if pairs == 4 then
        return "Hard"
    end
    return "Impossible!"
end

local function place_scene(self)
    -- The game object sits in the middle of the screen so the 1x1 background
    -- quad can be stretched over the viewport. The labels are their own game
    -- objects and are placed in the same pixel space as the cards.
    go.set_position(vmath.vector3(layout.width * 0.5, layout.height * 0.5, 0))
    go.set("#background", "size", vmath.vector3(layout.width, layout.height, 1))

    local unit = layout.unit
    local scale = HUD_FONT_UNITS * unit / FONT_SIZE
    local centre_y = layout.height - HUD_TOP_UNITS * unit
    local margin = HUD_SIDE_UNITS * unit

    go.set_position(vmath.vector3(margin, centre_y, HUD_Z), self.score_id)
    go.set_scale(scale, self.score_id)

    go.set_position(vmath.vector3(margin, centre_y - HUD_BEST_TOP_UNITS * unit, HUD_Z),
        self.best_id)
    go.set_scale(HUD_BEST_UNITS * unit / FONT_SIZE, self.best_id)

    go.set_position(vmath.vector3(layout.width - margin, centre_y, HUD_Z), self.time_id)
    go.set_scale(scale, self.time_id)

    go.set_position(vmath.vector3(layout.width * 0.5, centre_y, HUD_Z), self.hint_id)
    go.set_scale(hint_scale(self.hint), self.hint_id)
end

local function format_clock(seconds)
    return ("%d:%02d"):format(math.floor(seconds / 60), seconds % 60)
end

-- The best line stays empty until there is a stored record or the current run
-- has already beaten it.
local function best_text(self)
    if not self.best then
        return ""
    end
    if self.score > self.best then
        return BEST_FLASH
    end
    return ("BEST %d"):format(self.best)
end

local function refresh_hud(self)
    local whole = math.max(0, math.ceil(self.time_left))
    local score_text = ("%d"):format(self.score)
    local clock_text = format_clock(whole)
    local low = whole <= HUD_LOW_SECONDS

    if score_text ~= self.score_text then
        self.score_text = score_text
        set_label_text(self.score_id, score_text)
    end

    if clock_text ~= self.clock_text then
        self.clock_text = clock_text
        set_label_text(self.time_id, clock_text)
    end

    if self.best and self.score > self.best and not self.beat_best then
        self.beat_best = true
        print(("[memory] new best: %d beats %d"):format(self.score, self.best))
    end
    local best = best_text(self)
    if best ~= self.best_text then
        self.best_text = best
        set_label_text(self.best_id, best)
    end

    if low ~= self.low_time then
        self.low_time = low
        go.set(label_url(self.time_id), "color", low and HUD_LOW_COLOR or HUD_TIME_COLOR)
    end
end

local function flavour_text(stats)
    if stats.tables >= 2 then
        return ("%d tables cleared, %d pairs in a row"):format(stats.tables, stats.best_streak)
    end
    if stats.best_streak >= 3 then
        return ("Best streak: %d pairs in a row"):format(stats.best_streak)
    end
    if stats.pairs == 0 then
        return "No pairs found - the cards were too quick"
    end
    if stats.misses > stats.pairs * 2 then
        return ("%d pairs, %d misses"):format(stats.pairs, stats.misses)
    end
    return ("%d pairs found"):format(stats.pairs)
end

local function on_pair(self, a, b)
    -- Every earlier match in the current streak adds one bonus point, so the
    -- first match scores the base value and each following one scores more.
    local streak_bonus = self.stats.streak
    self.score = self.score + self.config.score_per_pair + streak_bonus
    self.stats.pairs = self.stats.pairs + 1
    self.stats.streak = self.stats.streak + 1
    self.stats.best_streak = math.max(self.stats.best_streak, self.stats.streak)

    local size = POP_UNITS * layout.unit
    spawn_pop(a.x, a.y, size)
    spawn_pop(b.x, b.y, size)
    audio.play("finish", { gain = 0.45, speed = 1.0 + math.min(0.5, self.stats.streak * 0.06) })
end

local function on_miss(self)
    self.stats.misses = self.stats.misses + 1
    self.stats.streak = 0
    audio.play("bounce", { gain = 0.7, speed = 0.7 })
end

local function on_bounce(self)
    if self.bounce_sound > 0 then
        return
    end
    self.bounce_sound = BOUNCE_SOUND_GAP
    audio.play("bounce", { gain = 0.22, speed = 0.9 + math.random() * 0.35 })
end

-- The browser only wakes its audio context on the first tap, so the loop is
-- retried every frame until music_start() reports it is really running.
local function pump_music(self)
    if not self.music_pending then
        return
    end
    self.music_started = audio.music_start()
    self.music_pending = not self.music_started
end

-- First-play tutorial: drop the hint and the halos as soon as the player has
-- flipped a card, so the table returns to its normal HUD.
local function stop_tutorial(self)
    if not self.tutorial then
        return
    end
    self.tutorial = false
    self.tutorial_shown = false
    self.tutorial_cards = {}
    for i = 1, #self.rings do
        go.delete(self.rings[i])
    end
    self.rings = {}
    set_hud_visible(self, true)
end

-- Point the halos at a pair that can already be flipped, so the first match is
-- a sure thing. The game script moves them every frame, so they ride along
-- with the sliding table.
local function show_tutorial_rings(self)
    self.tutorial_shown = true
    self.tutorial_cards = cards.first_pair(self.cards)
    if #self.tutorial_cards == 0 then
        return
    end
    local size = vmath.vector3(
        self.metrics.card_w * RING_W_SCALE,
        self.metrics.card_h * RING_H_SCALE,
        1)
    for _, card in ipairs(self.tutorial_cards) do
        self.rings[#self.rings + 1] = factory.create(msg.url("#ring_factory"),
            vmath.vector3(card.x, card.y, RING_Z), nil, { size = size })
    end
    print("[memory] tutorial: halos on a matching pair")
end

-- The first table with the tutorial peeks twice as long, so there is time to
-- read "Memorize!". Every other deal gets a smaller bump.
local function reveal_time(self)
    if self.tutorial then
        return self.config.reveal_seconds * MEMORIZE_BONUS_TUTORIAL
    end
    return self.config.reveal_seconds * MEMORIZE_BONUS
end

local function start_table(self)
    local wanted = math.min(self.pairs, self.max_pairs)
    self.table_pairs = wanted
    local speed = math.min(self.config.card_speed * 2.6,
        self.config.card_speed * (1 + 0.09 * (self.level - 1)))

    local reveal = reveal_time(self)
    self.cards = cards.new({
        unit = layout.unit,
        metrics = self.metrics,
        speed = speed,
        factory = self.card_factory,
        reveal = reveal,
        on_pair = function(a, b) on_pair(self, a, b) end,
        on_miss = function(a, b) on_miss(self, a, b) end,
        on_bounce = function(x, y) on_bounce(self, x, y) end,
    })
    cards.spawn(self.cards, deck.pick(wanted))
    if self.tutorial then
        set_hint(self, "Memorize!")
        set_hud_visible(self, false)
    else
        set_hint(self, difficulty_name(wanted))
    end
    print(("[memory] table %d: %d pairs, speed %.2f, reveal %.2f"):format(
        self.level, wanted, speed, reveal))
end

local function clear_table(self)
    self.stats.tables = self.stats.tables + 1
    self.score = self.score + self.table_pairs * self.config.score_per_pair
    self.level = self.level + 1
    self.pairs = math.min(self.pairs + 1, self.max_pairs)
    self.next_table = TABLE_PAUSE
    set_hint(self, "Cleared!")
    print(("[memory] table cleared, score %d, next %d pairs"):format(self.score, self.pairs))
end

local function finish(self)
    if self.finished then
        return
    end
    self.finished = true
    stop_tutorial(self)
    if self.cards then
        cards.reveal_all(self.cards)
    end
    self.music_pending = false
    audio.music_stop(MUSIC_FADE)
    audio.play("finish", { gain = 1.0, speed = 0.6 })
    print(("[memory] time up: score %d, %d pairs, %d misses"):format(
        self.score, self.stats.pairs, self.stats.misses))
    local best = math.max(self.score, self.best or 0)
    minit.report_result(self.score, {
        flavor_text = flavour_text(self.stats),
        delay = REPORT_DELAY_MS,
        user_data = ("%s%d"):format(BEST_PREFIX, best),
    })
end

local function rebuild(self)
    self.metrics = field.measure(layout.width, layout.height, layout.unit)
    self.max_pairs = math.max(2, math.min(self.config.max_pairs, field.capacity(self.metrics)))
    self.start_pairs = math.max(2, math.min(self.config.start_pairs, self.max_pairs))
    if self.pairs then
        self.pairs = math.min(self.pairs, self.max_pairs)
    end
    place_scene(self)
    if self.cards then
        cards.reflow(self.cards, self.metrics, layout.unit)
    end
end

function init(self)
    msg.post(".", "acquire_input_focus")
    audio.init()
    math.randomseed(os.time())

    self.config = read_config()
    self.card_factory = msg.url("#card_factory")
    self.score_id = factory.create(msg.url("#score_factory"), vmath.vector3(0, 0, HUD_Z))
    self.best_id = factory.create(msg.url("#best_factory"), vmath.vector3(0, 0, HUD_Z))
    self.time_id = factory.create(msg.url("#time_factory"), vmath.vector3(0, 0, HUD_Z))
    self.hint_id = factory.create(msg.url("#hint_factory"), vmath.vector3(0, 0, HUD_Z))
    self.score = 0
    self.score_text = ""
    self.best = read_best()
    self.best_text = ""
    self.beat_best = false
    self.time_left = self.config.round_seconds
    self.clock_text = ""
    self.clock_started = false
    self.low_time = false
    self.hint = ""
    self.level = 1
    self.bounce_sound = 0
    self.music_started = false
    self.music_pending = false
    self.finished = false
    self.tutorial = minit.should_show_tutorial()
    self.tutorial_shown = false
    self.tutorial_cards = {}
    self.rings = {}
    self.stats = { pairs = 0, misses = 0, streak = 0, best_streak = 0, tables = 0 }

    layout.refresh()
    rebuild(self)
    self.pairs = self.start_pairs
    refresh_hud(self)
    start_table(self)

    print(("[memory] start: %.0f s, %d..%d pairs, %d faces, tutorial %s, best %s"):format(
        self.config.round_seconds, self.start_pairs, self.max_pairs, deck.count(),
        tostring(self.tutorial), self.best and tostring(self.best) or "none"))
    minit.loading_done()
end

function update(self, dt)
    if layout.refresh() then
        rebuild(self)
    end

    pump_music(self)

    if self.bounce_sound > 0 then
        self.bounce_sound = math.max(0, self.bounce_sound - dt)
    end

    if not self.finished then
        if self.clock_started then
            self.time_left = math.max(0, self.time_left - dt)
            refresh_hud(self)
            if self.time_left <= 0 then
                finish(self)
            end
        elseif self.cards and cards.dealt(self.cards) then
            -- The opening reveal is free: the clock runs only once the table
            -- is face down and a card can actually be picked.
            self.clock_started = true
        end
    end

    if self.cards then
        cards.update(self.cards, dt)
    end

    for i = 1, #self.rings do
        local card = self.tutorial_cards[i]
        go.set_position(vmath.vector3(card.x, card.y, RING_Z), self.rings[i])
    end

    if self.tutorial and not self.tutorial_shown and cards.dealt(self.cards) then
        set_hint(self, "Tap two matching cards")
        show_tutorial_rings(self)
    end

    if self.finished then
        return
    end

    if self.cards and cards.count(self.cards) == 0 and not self.next_table then
        clear_table(self)
    end

    if self.next_table then
        self.next_table = self.next_table - dt
        if self.next_table <= 0 then
            self.next_table = nil
            start_table(self)
        end
    end
end

function on_input(self, action_id, action)
    if action_id ~= hash("touch") or not action.pressed then
        return
    end
    audio.set_active(true)
    if self.finished or not self.cards then
        return
    end
    self.music_pending = not self.music_started

    local x, y = layout.to_world(action.x, action.y)
    if cards.skip_peek(self.cards) then
        self.clock_started = true
        audio.play("tap", { gain = 0.7, speed = 0.95 + math.random() * 0.1 })
        return
    end
    if cards.pick(self.cards, x, y) then
        audio.play("tap", { gain = 0.7, speed = 0.95 + math.random() * 0.1 })
        if self.tutorial then
            stop_tutorial(self)
            set_hint(self, difficulty_name(self.table_pairs))
        end
    end
end
